<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>LXLPCL</AssemblyName>
    <RootNamespace>LXLPCL</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lx.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\lx.ico" />
    <Resource Include="Assets\lx.png" />
    <Content Include="Assets\Themes\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Skins\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
