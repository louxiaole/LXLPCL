<Window x:Class="LXLPCL.UI.Windows.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LXLPCL" Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ResizeMode="NoResize" FontFamily="{StaticResource AppFont}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource LiftShadow}" Padding="22,18,22,18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="IconGlyph" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="提示" FontSize="15" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,14,0,20">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="76"
                        Margin="0,0,10,0" Click="CancelButton_Click" Visibility="Collapsed"/>
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="确定" MinWidth="76"
                        Click="OkButton_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
