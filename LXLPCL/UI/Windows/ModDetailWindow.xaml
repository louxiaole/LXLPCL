<Window x:Class="LXLPCL.UI.Windows.ModDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模组详情" Width="760" Height="646" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="ModSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource BorderBrush}">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" Margin="2,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,0,14,9"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource LiftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="模组详情" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,4,20,18">

                    <Border Style="{StaticResource Card}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="72" Height="72" VerticalAlignment="Top">
                                <Border CornerRadius="12" Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="InitialText" Text="?" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image x:Name="IconImage" Stretch="UniformToFill" Visibility="Collapsed">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,72,72" RadiusX="12" RadiusY="12"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock x:Name="NameText" Text="-" FontSize="17" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="EnglishText" Text="" FontSize="11.5" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DescText" Text="" FontSize="12" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" MaxHeight="58"/>
                                <TextBlock x:Name="MetaText" Text="" FontSize="11" Margin="0,7,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="FolderButton" Style="{StaticResource SecondaryButton}"
                                            Content="打开所在文件夹" Margin="0,0,8,6" Click="OpenFolder_Click"/>
                                    <Button x:Name="CopyButton" Style="{StaticResource SecondaryButton}"
                                            Content="复制名称" Margin="0,0,8,6" Click="CopyName_Click"/>
                                    <Button x:Name="ModrinthButton" Style="{StaticResource SecondaryButton}"
                                            Content="转到 Modrinth" Margin="0,0,8,6" Click="OpenModrinth_Click"/>
                                    <Button x:Name="McmodButton" Style="{StaticResource SecondaryButton}"
                                            Content="转到 MC 百科" Margin="0,0,0,6" Click="OpenMcmod_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="文件信息" Style="{StaticResource SectionTitleText}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="文件名" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="FileNameText" Grid.Row="0" Grid.Column="1" Text="-"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Grid.Row="1" Text="状态" Style="{StaticResource InfoLabel}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,-3,0,4">
                                    <ToggleButton x:Name="DetailSwitch" Style="{StaticResource ModSwitch}"
                                                  VerticalAlignment="Center" Click="DetailSwitch_Click"/>
                                    <TextBlock x:Name="StatusText" Text="已启用" FontSize="12" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="版本" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="VersionValue" Grid.Row="2" Grid.Column="1" Text="-"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Grid.Row="3" Text="作者" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="AuthorValue" Grid.Row="3" Grid.Column="1" Text="-"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Grid.Row="4" Text="Mod ID" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="ModIdValue" Grid.Row="4" Grid.Column="1" Text="-"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Grid.Row="5" Text="加载器" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="LoaderValue" Grid.Row="5" Grid.Column="1" Text="-"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Grid.Row="6" Text="所属版本" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="TargetValue" Grid.Row="6" Grid.Column="1" Text="-"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Grid.Row="7" Text="文件大小" Style="{StaticResource InfoLabel}"/>
                                <TextBlock x:Name="SizeValue" Grid.Row="7" Grid.Column="1" Text="-"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Grid.Row="8" Text="完整路径" Style="{StaticResource InfoLabel}"
                                           Margin="0,0,14,0"/>
                                <TextBlock x:Name="PathText" Grid.Row="8" Grid.Column="1" Text="-"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="操作" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock x:Name="OnlineText" Text="" Style="{StaticResource HintText}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Style="{StaticResource DangerButton}" Content="删除模组" Padding="14,6"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Delete_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
