<Window x:Class="LXLPCL.UI.Windows.ModTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="汉化详情" Width="940" Height="680" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        MinWidth="760" MinHeight="480" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="CellBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" Effect="{StaticResource LiftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="汉化详情" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="保存汉化"
                            MinWidth="82" Margin="0,0,8,0" Click="Save_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}"
                            Width="32" Height="28" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,1" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ModNameText" Text="模组名称" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ModSubText" Text="" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="StatText" Grid.Column="1" Text="" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="18,10,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="FilterPanel" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource FilterChip}" Content="全部" GroupName="LangFilter"
                                 Tag="all" IsChecked="True" Checked="Filter_Checked" Margin="0,0,6,0"/>
                    <RadioButton Style="{StaticResource FilterChip}" Content="缺失" GroupName="LangFilter"
                                 Tag="missing" Checked="Filter_Checked" Margin="0,0,6,0"/>
                    <RadioButton Style="{StaticResource FilterChip}" Content="同原文" GroupName="LangFilter"
                                 Tag="same" Checked="Filter_Checked"/>
                </StackPanel>
                <TextBlock x:Name="HintText" Grid.Column="1" Text="" FontSize="11" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <Grid Grid.Row="3" Margin="18,0,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="10,0,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="68"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="语言键" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="原文" FontSize="11" FontWeight="SemiBold" Margin="10,0,10,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="汉化（可直接编辑）" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="状态" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </Grid>
                <Grid Grid.Row="1">
                    <ListBox x:Name="EntryList" Style="{StaticResource PclListBox}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PclListBoxItem}">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="68"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="12" Margin="10,0,10,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Column="2" Margin="0,0,10,0">
                                        <TextBox Style="{StaticResource CellBox}"
                                                 Text="{Binding TranslationText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding Source}"/>
                                        <TextBlock Text="点击填写汉化" FontSize="12" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Visibility="{Binding PlaceholderVisibility}"/>
                                    </Grid>
                                    <Border Grid.Column="3" Style="{StaticResource Badge}" Background="{Binding StatusBackground}"
                                            Padding="7,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding StatusBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="EmptyPanel" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                            <TextBlock x:Name="EmptyTitle" Text="没有可显示的汉化" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyDetail" Text="" FontSize="11.5" Margin="0,8,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="ExtraPanel" Grid.Row="2" Margin="0,10,0,0" Padding="12,9" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="ExtraTitle" Text="其它文本来源" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="ExtraNote" Text="不在 lang 文件中，需在手册 / 指南 / 任务配置里单独汉化"
                                   FontSize="10.5" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="132" Margin="0,6,0,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ExtraList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="62"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Type}" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Margin="8,0,8,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Coverage}" FontSize="11"
                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Border Grid.Column="3" Style="{StaticResource Badge}" Padding="7,1"
                                                Background="{Binding StatusBackground}" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                       Foreground="{Binding StatusBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
