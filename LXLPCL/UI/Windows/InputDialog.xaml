<Window x:Class="LXLPCL.UI.Windows.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LXLPCL" Width="400" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ResizeMode="NoResize" FontFamily="{StaticResource AppFont}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource LiftShadow}" Padding="22,18,22,18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentLightBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="命名" FontSize="15" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="HintText" Grid.Row="1" Text="给皮肤取一个名字" FontSize="12"
                       Margin="0,16,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>

            <TextBox x:Name="ValueBox" Grid.Row="2" Style="{StaticResource PclTextBox}" Height="38"
                     Padding="10,0" VerticalContentAlignment="Center" FontSize="13"
                     Margin="0,8,0,0" MaxLength="48" KeyDown="ValueBox_KeyDown"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="76"
                        Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="确定" MinWidth="76"
                        IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
