<Window x:Class="LXLPCL.UI.Windows.FindGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫描已有游戏" Width="820" Height="580" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFont}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource LiftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="扫描已有游戏" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20,4,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,8">
                        <TextBlock Text="检测到的游戏目录" Style="{StaticResource CardTitleText}"/>
                        <TextBlock x:Name="ScanCountText" Text="" FontSize="11" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Grid>
                    <ListBox x:Name="GameList" Grid.Row="1" Style="{StaticResource PclListBox}"
                             SelectionChanged="GameList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="9"
                                            Background="{DynamicResource AccentLightBrush}">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DetailText}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Path}" FontSize="9.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource AccentLightBrush}"
                                            CornerRadius="5" Padding="6,2" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="当前" FontSize="9.5"
                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="重新扫描" Padding="12,5"
                                Click="Rescan_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="选择文件夹…" Padding="12,5"
                                Margin="8,0,0,0" Click="Browse_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitleText" Text="请选择一个游戏目录" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock x:Name="PreviewPathText" Text="" FontSize="10.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="包含的版本" FontSize="11" Margin="0,14,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Grid Grid.Row="2">
                            <ListBox x:Name="VersionPreviewList" Style="{StaticResource PclListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30">
                                                <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}">
                                                    <TextBlock Text="{Binding IconText}" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Image Source="{Binding Logo}" Stretch="UniformToFill">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,30,30" RadiusX="8" RadiusY="8"/>
                                                    </Image.Clip>
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="PreviewEmptyText" Text="该目录中没有可用的版本"
                                       Style="{StaticResource HintText}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="20,0">
                <TextBlock x:Name="StatusText" Text="正在扫描..." Style="{StaticResource HintText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,150,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="取消" Padding="16,6"
                            Click="CloseButton_Click"/>
                    <Button x:Name="UseButton" Style="{StaticResource PrimaryButton}" Content="使用此目录"
                            Padding="18,6" Margin="10,0,0,0" IsEnabled="False" Click="Use_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
