<Window x:Class="LXLPCL.UI.Windows.ModManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模组管理" Width="880" Height="640" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="ModSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource BorderBrush}">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" Margin="2,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource LiftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="模组管理" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20,4,20,10">
                <StackPanel>
                    <TextBlock x:Name="VersionText" Text="-" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModsPathText" Text="-" FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource PclTextBox}" Width="180" Height="34"
                             TextChanged="SearchBox_TextChanged" ToolTip="按中文名、英文名或文件名筛选"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="添加模组…" Margin="8,0,0,0"
                            Click="AddMods_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="20,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="4,0,4,6">
                    <TextBlock x:Name="CountText" Text="" Style="{StaticResource HintText}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="全部启用" Click="EnableAll_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="全部禁用" Margin="8,0,0,0"
                                Click="DisableAll_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="打开模组目录" Margin="8,0,0,0"
                                Click="OpenFolder_Click"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="ModList_MouseDoubleClick"
                                 ContextMenuOpening="ModList_ContextMenuOpening">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="42" Height="42">
                                            <Border CornerRadius="9" Background="{DynamicResource SurfaceBrush}">
                                                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,42,42" RadiusX="9" RadiusY="9"/>
                                                </Image.Clip>
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="16"/>
                                            <TextBlock Text="{Binding MetaText}" FontSize="10" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton Style="{StaticResource ModSwitch}"
                                                          IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          Click="ModEnabled_Click"
                                                          ToolTip="开启 / 关闭该模组"/>
                                            <Button Style="{StaticResource DangerButton}" Content="删除" Padding="11,4"
                                                    Margin="10,0,0,0" Click="DeleteMod_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="EmptyText" Text="模组目录里还没有模组，可以点击右上角“添加模组…”导入。"
                                       Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="LoadingText" Text="正在读取模组信息…" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="20,0,20,0">
                <TextBlock x:Name="StatusText" Text="" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource SecondaryButton}" Content="关闭" HorizontalAlignment="Right"
                        MinWidth="96" Click="CloseButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
