<Window x:Class="LXLPCL.UI.Windows.ModpackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="整合包" Width="640" Height="620" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFont}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource LiftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="整合包" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,2,20,14">

                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="导入整合包" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="支持 LXLPCL 导出的 zip，也能识别 PCL2 / HMCL 整合包里 .minecraft 或 versions 目录结构。"
                                       Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock x:Name="ImportPathText" Text="尚未选择压缩包" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="PickPackButton" Style="{StaticResource SecondaryButton}"
                                        Content="选择压缩包…" HorizontalAlignment="Right" Click="PickPack_Click"/>
                            </Grid>

                            <TextBlock x:Name="ImportInfoText" Text="" Style="{StaticResource HintText}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="ImportProgress" Height="6" Minimum="0" Maximum="100"
                                         Margin="0,12,0,0" Visibility="Collapsed"/>
                            <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Content="开始导入"
                                    Margin="0,14,0,0" HorizontalAlignment="Left" MinWidth="112"
                                    Click="Import_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="导出整合包" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="把当前版本与选中的内容打包为 zip，导入后可还原为一个独立版本（版本隔离）。"
                                       Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="选择版本" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ExportVersionCombo" Style="{StaticResource PclComboBox}"
                                          Width="300" Height="36" HorizontalAlignment="Right"
                                          DisplayMemberPath="Id"/>
                            </Grid>

                            <WrapPanel Margin="0,14,0,0">
                                <CheckBox x:Name="ExportMods" Content="模组 mods" IsChecked="True" Margin="0,0,18,8"/>
                                <CheckBox x:Name="ExportConfig" Content="配置 config" IsChecked="True" Margin="0,0,18,8"/>
                                <CheckBox x:Name="ExportSaves" Content="存档 saves" Margin="0,0,18,8"/>
                                <CheckBox x:Name="ExportResourcePacks" Content="资源包" Margin="0,0,18,8"/>
                                <CheckBox x:Name="ExportShaderPacks" Content="光影" Margin="0,0,0,8"/>
                            </WrapPanel>

                            <TextBlock x:Name="ExportInfoText" Text="" Style="{StaticResource HintText}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="ExportProgress" Height="6" Minimum="0" Maximum="100"
                                         Margin="0,12,0,0" Visibility="Collapsed"/>
                            <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Content="开始导出"
                                    Margin="0,14,0,0" HorizontalAlignment="Left" MinWidth="112"
                                    Click="Export_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="20,0,20,0">
                <TextBlock x:Name="StatusText" Text="导入会在当前游戏目录的 versions 下新建版本，不会覆盖已有版本。"
                           Style="{StaticResource HintText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Border>
</Window>
