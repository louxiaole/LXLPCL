<Window x:Class="LXLPCL.UI.Windows.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LXLPCL" Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ResizeMode="NoResize" FontFamily="{StaticResource AppFont}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" Effect="{StaticResource LiftShadow}" Padding="24,20,24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentLightBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="发现新版本" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionLineText" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="&#xE711;"
                        FontFamily="{StaticResource IconFont}" FontSize="12" Padding="6,4"
                        VerticalAlignment="Center" Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,0" Padding="14" CornerRadius="8"
                    Background="{DynamicResource SurfaceAltBrush}" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" FontSize="12.5" LineHeight="21"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </ScrollViewer>
            </Border>

            <StackPanel x:Name="ProgressPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                <ProgressBar x:Name="DownloadBar" Style="{StaticResource PclProgressBar}" Height="8"
                             Minimum="0" Maximum="100"/>
                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="ProgressText" Text="准备下载…" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="SpeedText" FontSize="11.5" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="ButtonPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="SkipButton" Style="{StaticResource GhostButton}" Content="下次再说" MinWidth="76"
                        Margin="0,0,10,0" Click="Skip_Click"/>
                <Button x:Name="ManualButton" Style="{StaticResource SecondaryButton}" Content="打开下载页"
                        MinWidth="86" Margin="0,0,10,0" Click="Manual_Click"/>
                <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="立即更新"
                        MinWidth="86" IsDefault="True" Click="Update_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
