<Window x:Class="LXLPCL.UI.Windows.JavaDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载 Java" Width="520" Height="420" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFont}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource LiftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="下载 Java 运行时" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,6,22,0">
                <TextBlock Text="Mojang 官方 Java 运行时" Style="{StaticResource SectionTitleText}"/>
                <TextBlock Text="下载后保存在启动器目录，不修改系统环境，也不影响 PCL2 等其他启动器。"
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                <RadioButton x:Name="Java8Radio" Style="{StaticResource FilterChip}" GroupName="JavaMajor"
                             Content="Java 8（1.16.5 及更早）" Margin="0,0,8,8"/>
                <RadioButton x:Name="Java17Radio" Style="{StaticResource FilterChip}" GroupName="JavaMajor"
                             Content="Java 17（1.17 ~ 1.20.4）" IsChecked="True" Margin="0,0,8,8"/>
                <RadioButton x:Name="Java21Radio" Style="{StaticResource FilterChip}" GroupName="JavaMajor"
                             Content="Java 21（1.20.5 及更新）" Margin="0,0,8,8"/>

                <TextBlock x:Name="InstallPathText" Style="{StaticResource HintText}" TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Margin="0,14,0,0"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="22,0,22,0">
                <TextBlock Text="需要联网下载约 40 ~ 60 MB" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="取消"
                            MinWidth="88" Margin="0,0,8,0" Click="CloseButton_Click"/>
                    <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" Content="开始下载"
                            MinWidth="104" Click="Download_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
