<Window x:Class="LXLPCL.UI.Windows.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账户管理" Width="660" Height="610" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFont}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource LiftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="账户管理" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20,4,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="账户列表" Style="{StaticResource CardTitleText}" Margin="4,0,0,8"/>
                    <ListBox x:Name="AccountList" Grid.Row="1" Style="{StaticResource PclListBox}"
                             SelectionChanged="AccountList_SelectionChanged" MouseDoubleClick="AccountList_MouseDoubleClick"
                             Background="{DynamicResource SurfaceAltBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentLightBrush}">
                                        <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="删除账户"
                            Margin="0,8,0,0" IsEnabled="False" Click="DeleteButton_Click"/>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource FlatCard}" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="微软正版登录" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="使用 Microsoft 账户登录，支持正版服务器、皮肤与披风。"
                                       Style="{StaticResource CaptionText}" Margin="0,4,0,14" TextWrapping="Wrap"/>
                            <Button x:Name="MicrosoftLoginButton" Style="{StaticResource PrimaryButton}"
                                    Content="使用 Microsoft 账户登录" HorizontalAlignment="Stretch"
                                    Click="MicrosoftLogin_Click"/>

                            <Border x:Name="DeviceCodePanel" Visibility="Collapsed" Margin="0,12,0,0"
                                    Background="{DynamicResource SurfaceAltBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="浏览器已打开登录页面，若未打开请访问："
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="VerificationUriText" Text="https://www.microsoft.com/link"
                                               FontSize="12" Margin="0,3,0,10" Foreground="{DynamicResource AccentTextBrush}"/>
                                    <TextBlock Text="输入以下代码完成授权" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="DeviceCodeText" Text="--------" FontFamily="Consolas"
                                               FontSize="26" FontWeight="Bold" Margin="0,2,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CopyCodeButton" Style="{StaticResource SecondaryButton}"
                                                Content="复制代码" Click="CopyCode_Click"/>
                                        <Button x:Name="OpenLoginButton" Style="{StaticResource SecondaryButton}"
                                                Content="打开登录页面" Margin="8,0,0,0" Click="OpenLogin_Click"/>
                                        <Button x:Name="CancelLoginButton" Style="{StaticResource SecondaryButton}"
                                                Content="取消" Margin="8,0,0,0" Click="CancelLogin_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LoginStatusText" Text="正在等待浏览器授权…" Style="{StaticResource HintText}"
                                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,18,0,14"/>

                            <TextBlock Text="离线登录" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="输入一个用户名即可开始游戏，适用于单机与局域网。"
                                       Style="{StaticResource CaptionText}" Margin="0,4,0,14" TextWrapping="Wrap"/>
                            <TextBox x:Name="NameBox" Style="{StaticResource PclTextBox}" MaxLength="16"
                                     KeyDown="NameBox_KeyDown" ToolTip="1-16 个字符，仅字母、数字、下划线"/>
                            <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="添加并登录"
                                    HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="AddButton_Click"/>
                            <TextBlock Text="离线账户的 UUID 由用户名生成，皮肤需使用第三方皮肤站。"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="关闭" MinWidth="80" Margin="0,0,10,0"
                            Click="CloseButton_Click"/>
                    <Button x:Name="UseButton" Style="{StaticResource PrimaryButton}" Content="使用此账户" MinWidth="110"
                            Click="UseButton_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
