<local:PageBase x:Class="LXLPCL.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LXLPCL"
             FontFamily="{StaticResource AppFont}">
    <local:PageBase.Resources>
        <Style x:Key="SettingsNav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,9" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,14">
            <TextBlock Text="设置" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="调整启动器、游戏、Java 与界面选项" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="10,12">
                <StackPanel>
                    <TextBlock Text="设置分类" Style="{StaticResource CardTitleText}" Margin="8,0,0,8"/>
                    <RadioButton x:Name="NavBasic" Style="{StaticResource SettingsNav}" GroupName="SettingsNav"
                                 Tag="basic" IsChecked="True" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="启动器" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGame" Style="{StaticResource SettingsNav}" GroupName="SettingsNav"
                                 Tag="game" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="游戏与性能" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavJava" Style="{StaticResource SettingsNav}" GroupName="SettingsNav"
                                 Tag="java" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Java" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource SettingsNav}" GroupName="SettingsNav"
                                 Tag="appearance" Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="外观" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Separator Margin="0,10,0,8"/>
                    <Button Style="{StaticResource LinkButton}" Content="打开启动器数据目录" FontSize="11" Margin="8,2"
                            Click="OpenDataDir_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <!-- 启动器 -->
                <ScrollViewer x:Name="BasicPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="游戏目录" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Text="所有版本、模组与存档都保存在此目录" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0"/>
                                <Border Style="{StaticResource FlatCard}" Padding="13,10" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="GameDirText" Text="-" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource SecondaryButton}" Content="检测" Padding="12,5"
                                                    Margin="8,0,0,0" Click="DetectGameDir_Click"
                                                    ToolTip="扫描 PCL2 / HMCL / 官方启动器已有的游戏目录"/>
                                            <Button Style="{StaticResource SecondaryButton}" Content="更改" Padding="12,5"
                                                    Margin="6,0,0,0" Click="BrowseGameDir_Click"/>
                                            <Button Style="{StaticResource SecondaryButton}" Content="打开" Padding="12,5"
                                                    Margin="6,0,0,0" Click="OpenGameDir_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="下载与资源" Style="{StaticResource SectionTitleText}"/>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="下载源" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DownloadSourceCombo" Style="{StaticResource PclComboBox}" Width="170"
                                              Height="36" HorizontalAlignment="Right" SelectionChanged="DownloadSourceCombo_SelectionChanged">
                                        <ComboBoxItem Content="自动（优先镜像）"/>
                                        <ComboBoxItem Content="官方源"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="国内网络建议使用自动，将优先通过 BMCLAPI 镜像下载。" Style="{StaticResource HintText}"
                                           Margin="0,6,0,0"/>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="下载线程" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ThreadsValueText" Text="8" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}"/>
                                </Grid>
                                <Slider x:Name="ThreadsSlider" Style="{StaticResource PclSlider}" Minimum="1" Maximum="32"
                                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                                        ValueChanged="ThreadsSlider_ValueChanged"/>
                                <TextBlock Text="线程越多下载越快，但过高可能被服务器限制。" Style="{StaticResource HintText}"
                                           Margin="0,4,0,0"/>

                                <Separator Margin="0,16,0,12"/>

                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="自动检查资源文件" FontSize="12"/>
                                        <TextBlock Text="启动前补齐缺失的资源与依赖库" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoAssetsToggle" Style="{StaticResource ToggleSwitch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Click="AutoAssetsToggle_Click"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="自动下载 Java" FontSize="12"/>
                                        <TextBlock Text="缺少所需 Java 时提示并下载 Mojang 运行时" Style="{StaticResource HintText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoJavaToggle" Style="{StaticResource ToggleSwitch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Click="AutoJavaToggle_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="社区资源" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Text="模组、资源包与光影的下载命名和管理方式" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0"/>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="文件名格式" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="FileNameFormatCombo" Style="{StaticResource PclComboBox}" Width="290"
                                              Height="36" HorizontalAlignment="Right"
                                              SelectionChanged="FileNameFormatCombo_SelectionChanged"/>
                                </Grid>
                                <TextBlock Text="下载的社区资源会按所选格式重命名，扩展名保持不变。" Style="{StaticResource HintText}"
                                           Margin="0,6,0,0"/>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="Mod 管理样式" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ModStyleCombo" Style="{StaticResource PclComboBox}" Width="290"
                                              Height="36" HorizontalAlignment="Right"
                                              SelectionChanged="ModStyleCombo_SelectionChanged">
                                        <ComboBoxItem Content="标题显示译名，详情显示文件名"/>
                                        <ComboBoxItem Content="标题显示文件名，详情显示译名"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="只影响模组管理列表中名称与文件名的显示位置。" Style="{StaticResource HintText}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 游戏 -->
                <ScrollViewer x:Name="GamePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="性能" Style="{StaticResource SectionTitleText}"/>

                                <TextBlock Text="内存分配" FontSize="12" Margin="0,16,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="AutoMemoryRadio" Style="{StaticResource PclRadioButton}"
                                                 Content="自动配置" GroupName="MemoryMode" Checked="MemoryMode_Checked"/>
                                    <RadioButton x:Name="CustomMemoryRadio" Style="{StaticResource PclRadioButton}"
                                                 Content="自定义" GroupName="MemoryMode" Margin="22,0,0,0"
                                                 Checked="MemoryMode_Checked"/>
                                </StackPanel>

                                <TextBlock x:Name="MemoryValueText" Text="4096 MB" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,12,0,0"/>
                                <Slider x:Name="MemorySlider" Style="{StaticResource PclSlider}" Minimum="512" Maximum="16384"
                                        TickFrequency="512" Margin="0,2,0,0" ValueChanged="MemorySlider_ValueChanged"/>
                                <TextBlock x:Name="MemoryHintText" Text="根据系统内存自动推荐，通常无需手动调整。"
                                           Style="{StaticResource HintText}" Margin="0,4,0,0"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="已使用内存" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="UsedMemoryText" Text="-" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                                <ProgressBar x:Name="UsedMemoryBar" Style="{StaticResource PclProgressBar}" Margin="0,4,0,0"/>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="游戏分配" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="AllocMemoryText" Text="-" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                                <ProgressBar x:Name="AllocMemoryBar" Style="{StaticResource PclProgressBar}" Margin="0,4,0,0"/>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="窗口尺寸" FontSize="12" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="WindowWidthBox" Style="{StaticResource PclTextBox}" Width="76" Height="32"
                                                 TextAlignment="Center" LostFocus="WindowSizeBox_LostFocus"/>
                                        <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBox x:Name="WindowHeightBox" Style="{StaticResource PclTextBox}" Width="76" Height="32"
                                                 TextAlignment="Center" LostFocus="WindowSizeBox_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="全屏启动" FontSize="12"/>
                                        <TextBlock Text="以全屏模式打开游戏" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="FullscreenToggle" Style="{StaticResource ToggleSwitch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Click="FullscreenToggle_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="启动参数" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Text="追加到自动生成参数之后，可留空" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0"/>

                                <TextBlock Text="JVM 参数" FontSize="12" Margin="0,14,0,0"/>
                                <TextBox x:Name="JvmArgsBox" Style="{StaticResource PclTextBox}" Height="60"
                                         AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                         LostFocus="JvmArgsBox_LostFocus" ToolTip="例如 -XX:+UseG1GC -XX:+UnlockExperimentalVMOptions"/>

                                <TextBlock Text="游戏参数" FontSize="12" Margin="0,14,0,0"/>
                                <TextBox x:Name="GameArgsBox" Style="{StaticResource PclTextBox}" Height="60"
                                         AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                         LostFocus="GameArgsBox_LostFocus" ToolTip="例如 --fullscreen"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Java -->
                <ScrollViewer x:Name="JavaPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Java 运行时" Style="{StaticResource SectionTitleText}"/>
                                        <TextBlock Text="启动器会自动匹配所需 Java 版本，也可以手动指定" Style="{StaticResource CaptionText}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Click="RefreshJava_Click" ToolTip="重新检测 Java"/>
                                </Grid>

                                <TextBlock Text="默认 Java" FontSize="12" Margin="0,16,0,0"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="GlobalJavaCombo" Style="{StaticResource PclComboBox}" Height="38"
                                              DisplayMemberPath="Display" SelectionChanged="GlobalJavaCombo_SelectionChanged"/>
                                    <Button x:Name="DownloadJavaButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="下载 Java"
                                            Margin="8,0,0,0" Click="DownloadJava_Click"
                                            ToolTip="从 Mojang 官方下载 Java 8 / 17 / 21，保存在启动器目录"/>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="手动添加"
                                            Margin="8,0,0,0" Click="AddJava_Click"/>
                                </Grid>
                                <TextBlock x:Name="JavaCountText" Text="" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="检测到的 Java" Style="{StaticResource CardTitleText}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="JavaList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                                    Padding="12,10" Margin="0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="9"
                                                            Background="{DynamicResource AccentLightBrush}">
                                                        <TextBlock Text="J" FontSize="14" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Display}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Path}" FontSize="10"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{DynamicResource HoverBrush}">
                                                        <TextBlock Text="{Binding Source}" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="JavaEmptyText" Text="正在检测 Java..." Style="{StaticResource HintText}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 外观 -->
                <ScrollViewer x:Name="AppearancePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="界面主题" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Text="切换浅色或夜间外观，选择后立即生效" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0"/>
                                <WrapPanel Margin="0,14,0,-10">
                                    <RadioButton x:Name="ThemeLightRadio" Style="{StaticResource ThemeOptionRadio}"
                                                 Tag="light" GroupName="ThemeMode" Checked="ThemeMode_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" CornerRadius="5" Background="#F4F6F9"
                                                    BorderBrush="#D8DDE5" BorderThickness="1"/>
                                            <TextBlock Text="浅色" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ThemeDarkRadio" Style="{StaticResource ThemeOptionRadio}"
                                                 Tag="dark" GroupName="ThemeMode" Checked="ThemeMode_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" CornerRadius="5" Background="#1E2129"
                                                    BorderBrush="#3C4351" BorderThickness="1"/>
                                            <TextBlock Text="深色" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ThemeMidnightRadio" Style="{StaticResource ThemeOptionRadio}"
                                                 Tag="midnight" GroupName="ThemeMode" Checked="ThemeMode_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" CornerRadius="5" Background="#13151A"
                                                    BorderBrush="#3C4351" BorderThickness="1"/>
                                            <TextBlock Text="午夜黑" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ThemeSepiaRadio" Style="{StaticResource ThemeOptionRadio}"
                                                 Tag="sepia" GroupName="ThemeMode" Checked="ThemeMode_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" CornerRadius="5" Background="#FCF9F3"
                                                    BorderBrush="#DCD4C5" BorderThickness="1"/>
                                            <TextBlock Text="护眼" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ThemeSystemRadio" Style="{StaticResource ThemeOptionRadio}"
                                                 Tag="system" GroupName="ThemeMode" Checked="ThemeMode_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" CornerRadius="5" BorderBrush="#9AA1AC"
                                                    BorderThickness="1">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                                        <GradientStop Color="#1E2129" Offset="0.5"/>
                                                        <GradientStop Color="#1E2129" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="跟随系统" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="主题背景" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Text="给启动器铺一层动漫插画，也可以换成自己的图片" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0"/>
                                <WrapPanel Margin="0,14,0,-10">
                                    <RadioButton x:Name="BgNoneRadio" Style="{StaticResource ThemeBackgroundRadio}"
                                                 Tag="none" GroupName="ThemeBackground" Checked="ThemeBackground_Checked">
                                        <StackPanel Width="108">
                                            <Border Height="58" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="无" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="无背景" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="BgSakuraRadio" Style="{StaticResource ThemeBackgroundRadio}"
                                                 Tag="sakura" GroupName="ThemeBackground" Checked="ThemeBackground_Checked">
                                        <StackPanel Width="108">
                                            <Border x:Name="BgSakuraTile" Height="58" CornerRadius="6" ClipToBounds="True">
                                                <Border.Background>
                                                    <ImageBrush x:Name="BgSakuraImage" Stretch="UniformToFill"
                                                                Viewbox="0,0,1,0.9" ViewboxUnits="RelativeToBoundingBox"/>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="樱花夜" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="BgStarryRadio" Style="{StaticResource ThemeBackgroundRadio}"
                                                 Tag="starry" GroupName="ThemeBackground" Checked="ThemeBackground_Checked">
                                        <StackPanel Width="108">
                                            <Border x:Name="BgStarryTile" Height="58" CornerRadius="6" ClipToBounds="True">
                                                <Border.Background>
                                                    <ImageBrush x:Name="BgStarryImage" Stretch="UniformToFill"
                                                                Viewbox="0,0,1,0.9" ViewboxUnits="RelativeToBoundingBox"/>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="极光星空" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="BgNeonRadio" Style="{StaticResource ThemeBackgroundRadio}"
                                                 Tag="neon" GroupName="ThemeBackground" Checked="ThemeBackground_Checked">
                                        <StackPanel Width="108">
                                            <Border x:Name="BgNeonTile" Height="58" CornerRadius="6" ClipToBounds="True">
                                                <Border.Background>
                                                    <ImageBrush x:Name="BgNeonImage" Stretch="UniformToFill"
                                                                Viewbox="0,0,1,0.9" ViewboxUnits="RelativeToBoundingBox"/>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="霓虹都市" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="BgForestRadio" Style="{StaticResource ThemeBackgroundRadio}"
                                                 Tag="forest" GroupName="ThemeBackground" Checked="ThemeBackground_Checked">
                                        <StackPanel Width="108">
                                            <Border x:Name="BgForestTile" Height="58" CornerRadius="6" ClipToBounds="True">
                                                <Border.Background>
                                                    <ImageBrush x:Name="BgForestImage" Stretch="UniformToFill"
                                                                Viewbox="0,0,1,0.9" ViewboxUnits="RelativeToBoundingBox"/>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="精灵森林" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="选择本地图片…"
                                            Click="CustomBackground_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="恢复无背景" Margin="8,0,0,0"
                                            Click="ClearBackground_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="BackgroundHintText" Style="{StaticResource HintText}" Margin="0,8,0,0"
                                           Text="支持 JPG / PNG / BMP，建议使用 16:9 横向图片。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="主题色" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Text="选择你喜欢的强调色，界面会立即更新" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource IconButton}" Width="38" Height="38" Tag="#2E7CF6"
                                            Click="Accent_Click" ToolTip="#2E7CF6">
                                        <Ellipse Width="22" Height="22" Fill="#2E7CF6"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="38" Height="38" Tag="#7C5CFC"
                                            Click="Accent_Click" ToolTip="#7C5CFC" Margin="6,0,0,0">
                                        <Ellipse Width="22" Height="22" Fill="#7C5CFC"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="38" Height="38" Tag="#E5484D"
                                            Click="Accent_Click" ToolTip="#E5484D" Margin="6,0,0,0">
                                        <Ellipse Width="22" Height="22" Fill="#E5484D"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="38" Height="38" Tag="#E19A2B"
                                            Click="Accent_Click" ToolTip="#E19A2B" Margin="6,0,0,0">
                                        <Ellipse Width="22" Height="22" Fill="#E19A2B"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="38" Height="38" Tag="#23A55A"
                                            Click="Accent_Click" ToolTip="#23A55A" Margin="6,0,0,0">
                                        <Ellipse Width="22" Height="22" Fill="#23A55A"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="38" Height="38" Tag="#0FA5A5"
                                            Click="Accent_Click" ToolTip="#0FA5A5" Margin="6,0,0,0">
                                        <Ellipse Width="22" Height="22" Fill="#0FA5A5"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="38" Height="38" Tag="#E0699A"
                                            Click="Accent_Click" ToolTip="#E0699A" Margin="6,0,0,0">
                                        <Ellipse Width="22" Height="22" Fill="#E0699A"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="38" Height="38" Tag="#5B6B84"
                                            Click="Accent_Click" ToolTip="#5B6B84" Margin="6,0,0,0">
                                        <Ellipse Width="22" Height="22" Fill="#5B6B84"/>
                                    </Button>
                                </WrapPanel>
                                <TextBlock x:Name="AccentValueText" Text="当前：#2E7CF6" Style="{StaticResource HintText}"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="界面动画" Style="{StaticResource SectionTitleText}"/>
                                <Grid Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="切换页面时播放过渡动画" FontSize="12"/>
                                        <TextBlock Text="关闭可减少低配设备上的卡顿" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AnimationToggle" Style="{StaticResource ToggleSwitch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Click="AnimationToggle_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="启动器信息" Style="{StaticResource SectionTitleText}"/>
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="版本" Style="{StaticResource HintText}"/>
                                    <TextBlock x:Name="VersionValueText" Text="LXLPCL 1.0.0" FontSize="12"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="配置文件" Style="{StaticResource HintText}"/>
                                    <TextBlock Text="LXLPCL.json" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="日志目录" Style="{StaticResource HintText}"/>
                                    <TextBlock Text="LXLPCLData\logs" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Button Style="{StaticResource SecondaryButton}" Content="打开日志目录" HorizontalAlignment="Left"
                                        Margin="0,14,0,0" Click="OpenLogs_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</local:PageBase>
