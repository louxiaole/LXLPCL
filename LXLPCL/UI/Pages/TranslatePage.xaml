<local:PageBase x:Class="LXLPCL.UI.Pages.TranslatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LXLPCL"
             FontFamily="{StaticResource AppFont}">
    <local:PageBase.Resources>
        <DataTemplate x:Key="ModRowTemplate">
            <Border Padding="10,8" Background="Transparent" Cursor="Hand" ToolTip="{Binding PathText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubText}" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CoverageText}" FontSize="11" Width="130"
                               Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="12,0,0,0" Padding="8,2"
                            Background="{Binding StatusBackground}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{Binding StatusBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LangEntryTemplate">
            <Border Padding="8,5" Background="Transparent" Cursor="Hand" ToolTip="{Binding ToolTip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="66"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ModName}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Key}" FontFamily="Consolas" FontSize="10.5"
                               Margin="8,0,8,0" Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="11.5" Margin="0,0,10,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding TranslationText}" FontSize="11.5"
                               Foreground="{Binding TranslationBrush}" Margin="0,0,10,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TranslationText}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="4" Style="{StaticResource Badge}" Padding="7,1" Background="{Binding StatusBackground}"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding StatusBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ToolLabel" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="TableHead" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </local:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,12">
            <StackPanel>
                <TextBlock Text="汉化" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="查看模组与整合包的原文 / 汉化对照，标出缺失与未翻译的条目"
                           Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="BusyText" Text="" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"
                           MaxWidth="320"/>
                <Button Style="{StaticResource SecondaryButton}" Content="重新扫描" Click="Rescan_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,0,10">
            <RadioButton Style="{StaticResource FilterChip}" Content="Mod 汉化" GroupName="TrMode" Tag="mod"
                         IsChecked="True" Checked="Mode_Checked" Margin="0,0,8,0"/>
            <RadioButton Style="{StaticResource FilterChip}" Content="整合包汉化" GroupName="TrMode" Tag="pack"
                         Checked="Mode_Checked"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- Mod 汉化 -->
            <Grid x:Name="ModModule">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="14,10">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="版本" Style="{StaticResource ToolLabel}"/>
                        <ComboBox x:Name="VersionBox" Style="{StaticResource PclComboBox}" Width="200"
                                  Margin="0,0,16,0" SelectionChanged="Version_Changed"/>
                        <TextBlock Text="搜索" Style="{StaticResource ToolLabel}"/>
                        <TextBox x:Name="ModSearchBox" Style="{StaticResource PclTextBox}" Width="170" Height="38"
                                 Margin="0,0,16,0" VerticalContentAlignment="Center" TextChanged="Search_Changed"/>
                        <RadioButton Style="{StaticResource FilterChip}" Content="全部" GroupName="ModFilter"
                                     Tag="all" IsChecked="True" Checked="ModFilter_Checked" Margin="0,0,6,0"/>
                        <RadioButton Style="{StaticResource FilterChip}" Content="有汉化" GroupName="ModFilter"
                                     Tag="translated" Checked="ModFilter_Checked" Margin="0,0,6,0"/>
                        <RadioButton Style="{StaticResource FilterChip}" Content="有缺失" GroupName="ModFilter"
                                     Tag="missing" Checked="ModFilter_Checked" Margin="0,0,6,0"/>
                        <RadioButton Style="{StaticResource FilterChip}" Content="未汉化" GroupName="ModFilter"
                                     Tag="untranslated" Checked="ModFilter_Checked"/>
                    </WrapPanel>
                </Border>

                <TextBlock x:Name="ModSummaryText" Grid.Row="1" Text="" FontSize="11" Margin="4,8,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6,4" Margin="0,8,0,0">
                    <Grid>
                        <ListBox x:Name="ModList" Style="{StaticResource PclListBox}" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ModList_SelectionChanged"
                                 ItemTemplate="{StaticResource ModRowTemplate}"/>
                        <TextBlock x:Name="ModEmpty" Text="没有找到模组" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="460" TextAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 整合包汉化 -->
            <Grid x:Name="PackModule" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="14,10">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="整合包" Style="{StaticResource ToolLabel}"/>
                        <ComboBox x:Name="PackVersionBox" Style="{StaticResource PclComboBox}" Width="200"
                                  Margin="0,0,16,0" SelectionChanged="PackVersion_Changed"/>
                        <TextBlock Text="搜索" Style="{StaticResource ToolLabel}"/>
                        <TextBox x:Name="PackSearchBox" Style="{StaticResource PclTextBox}" Width="170" Height="38"
                                 Margin="0,0,16,0" VerticalContentAlignment="Center" TextChanged="Search_Changed"/>
                        <RadioButton Style="{StaticResource FilterChip}" Content="查看整合包全部" GroupName="PackView"
                                     Tag="all" IsChecked="True" Checked="PackView_Checked" Margin="0,0,6,0"/>
                        <RadioButton Style="{StaticResource FilterChip}" Content="Mod 列表" GroupName="PackView"
                                     Tag="list" Checked="PackView_Checked"/>
                    </WrapPanel>
                </Border>

                <TextBlock x:Name="PackSummaryText" Grid.Row="1" Text="" FontSize="11" Margin="4,8,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <!-- 直接查看整合包所有条目 -->
                    <Grid x:Name="PackAllHost">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource FlatCard}" Padding="12,7" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="66"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模组" Style="{StaticResource TableHead}"/>
                                <TextBlock Grid.Column="1" Text="语言键" Style="{StaticResource TableHead}" Margin="8,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="原文" Style="{StaticResource TableHead}"/>
                                <TextBlock Grid.Column="3" Text="汉化" Style="{StaticResource TableHead}"/>
                                <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource TableHead}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6,4">
                            <Grid>
                                <ListBox x:Name="PackAllList" Style="{StaticResource PclListBox}" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         SelectionChanged="PackAllList_SelectionChanged"
                                         ItemTemplate="{StaticResource LangEntryTemplate}"/>
                                <TextBlock x:Name="PackAllEmpty" Text="没有可显示的条目" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="460" TextAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 整合包内的 Mod 列表 -->
                    <Grid x:Name="PackModsHost" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Padding="6,4">
                            <Grid>
                                <ListBox x:Name="PackModList" Style="{StaticResource PclListBox}" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="PackModList_SelectionChanged"
                                         ItemTemplate="{StaticResource ModRowTemplate}"/>
                                <TextBlock x:Name="PackModEmpty" Text="这个整合包里没有找到模组" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="460" TextAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</local:PageBase>
