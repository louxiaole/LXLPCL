<local:PageBase x:Class="LXLPCL.UI.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LXLPCL"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,14">
            <StackPanel>
                <TextBlock Text="版本管理" Style="{StaticResource PageTitleText}"/>
                <TextBlock x:Name="VersionSummaryText" Text="管理已安装的版本、模组与启动设置"
                           Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ModpackButton" Style="{StaticResource SecondaryButton}" Content="导入整合包" Margin="0,0,8,0"
                        Click="Modpack_Click" ToolTip="导入 PCL2 / HMCL / LXLPCL 导出的整合包 zip"/>
                <Button Style="{StaticResource SecondaryButton}" Content="扫描已有游戏" Margin="0,0,8,0"
                        Click="ScanGames_Click" ToolTip="识别 PCL2 / HMCL / 官方启动器已安装的版本与整合包"/>
                <Button Style="{StaticResource SecondaryButton}" Content="打开游戏目录" Margin="0,0,8,0"
                        Click="OpenGameFolder_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="下载新版本" Click="DownloadVersion_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- 版本列表 -->
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,2,4,8">
                        <TextBlock Text="已安装版本" Style="{StaticResource CardTitleText}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                                Width="30" Height="30" Click="Refresh_Click" ToolTip="刷新版本列表"/>
                    </Grid>
                    <ListBox x:Name="VersionList" Grid.Row="1" Style="{StaticResource PclListBox}"
                             SelectionChanged="VersionList_SelectionChanged" MouseDoubleClick="VersionList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="38" Height="38">
                                        <Border CornerRadius="10" Background="{Binding IconBrush}">
                                            <TextBlock Text="{Binding IconText}" Foreground="White" FontSize="11"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding Logo}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,38,38" RadiusX="10" RadiusY="10"/>
                                            </Image.Clip>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,9" Margin="0,8,0,0">
                        <Grid>
                            <TextBlock x:Name="VersionCountText" Text="0 个版本" Style="{StaticResource HintText}"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource LinkButton}" Content="打开 versions 文件夹" FontSize="11"
                                    HorizontalAlignment="Right" Click="OpenVersionsFolder_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 版本详情 -->
            <Grid Grid.Column="2">
                <Border x:Name="DetailPanel" Style="{StaticResource Card}" Padding="22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="50" Height="50">
                                    <Border x:Name="DetailIconTile" CornerRadius="12"
                                            Background="{DynamicResource AccentGradientBrush}">
                                        <TextBlock x:Name="DetailIconText" Text="MC" Foreground="White" FontSize="14"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image x:Name="DetailIconImage" Stretch="UniformToFill" Visibility="Collapsed">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,50,50" RadiusX="12" RadiusY="12"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailTitleText" Text="选择一个版本" FontSize="19" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailSubtitleText" Text="" Style="{StaticResource CaptionText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailLoaderText" Text="原版" FontSize="11"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource FlatCard}" Padding="14" Margin="0,18,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="版本目录" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="DetailPathText" Grid.Column="1" Text="-" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Text="加载器" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="DetailLoaderValueText" Grid.Row="1" Grid.Column="1" Text="-"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Text="版本类型" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="DetailTypeText" Grid.Row="2" Grid.Column="1" Text="-"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Text="模组目录" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="DetailModsPathText" Grid.Row="3" Grid.Column="1" Text="-"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="4" Text="上次游玩" Style="{StaticResource HintText}"/>
                                    <TextBlock x:Name="DetailLastPlayedText" Grid.Row="4" Grid.Column="1" Text="-"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="启动设置" Style="{StaticResource SectionTitleText}" Margin="0,20,0,0"/>

                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="内存" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="VMemoryValueText" Text="4096 MB" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <CheckBox x:Name="VMemoryFollow" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="True" ToolTip="使用全局内存设置" Click="VMemoryFollow_Click"/>
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="VMemorySlider" Style="{StaticResource PclSlider}" Minimum="512" Maximum="16384"
                                    ValueChanged="VMemorySlider_ValueChanged" Margin="0,4,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="Java" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VJavaEffectiveText" Text="" Style="{StaticResource HintText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ComboBox x:Name="VJavaCombo" Style="{StaticResource PclComboBox}" Height="38"
                                      Margin="0,6,0,0" DisplayMemberPath="Display" SelectionChanged="VJavaCombo_SelectionChanged"/>

                            <Grid Margin="0,14,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="版本隔离" FontSize="12"/>
                                    <TextBlock Text="开启后模组与存档放在版本目录内，互不干扰" Style="{StaticResource HintText}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="VIsolatedToggle" Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Click="VIsolatedToggle_Click"/>
                            </Grid>

                            <TextBlock Text="自定义 JVM 参数" FontSize="12" Margin="0,16,0,0"/>
                            <TextBox x:Name="VJvmArgsBox" Style="{StaticResource PclTextBox}" Height="56"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontSize="12" Margin="0,6,0,0" LostFocus="VJvmArgsBox_LostFocus"
                                     ToolTip="例如 -XX:+UseG1GC，每行或空格分隔"/>
                            <TextBlock Text="留空则使用全局参数，附加到自动生成的参数之后。" Style="{StaticResource HintText}"
                                       Margin="0,5,0,0"/>

                            <Grid Margin="0,18,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="LaunchVersionButton" Style="{StaticResource PrimaryButton}"
                                            Content="启动此版本" MinWidth="116" Click="LaunchVersion_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="打开版本文件夹" Margin="8,0,0,0"
                                            Click="OpenVersionFolder_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="管理模组"
                                            Margin="8,0,0,0" Click="ManageMods_Click"/>
                                    <Button x:Name="ExportPackButton" Style="{StaticResource SecondaryButton}"
                                            Content="导出整合包" Margin="8,0,0,0" Click="ExportPack_Click"
                                            ToolTip="把此版本与所选模组、配置打包为 zip"/>
                                </StackPanel>
                                <Button x:Name="DeleteVersionButton" Style="{StaticResource DangerButton}" Content="删除版本"
                                        HorizontalAlignment="Right" Click="DeleteVersion_Click"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="还没有安装任何版本" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="前往下载页安装原版游戏或 Fabric 版本" Style="{StaticResource CaptionText}"
                                   Margin="0,6,0,18" HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="前往下载" MinWidth="120"
                                HorizontalAlignment="Center" Click="DownloadVersion_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</local:PageBase>
