<local:PageBase x:Class="LXLPCL.UI.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LXLPCL"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,14">
            <TextBlock Text="关于" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="LXLPCL 启动器信息与致谢" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 头部 -->
                <Border Style="{StaticResource Card}" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="68" Height="68" CornerRadius="18" Background="{DynamicResource AccentGradientBrush}"
                                Effect="{StaticResource AccentShadow}" VerticalAlignment="Top">
                            <TextBlock Text="LX" FontSize="24" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,20,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LXLPCL" FontSize="24" FontWeight="SemiBold"/>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentLightBrush}"
                                        Margin="10,0,0,0" Padding="8,2">
                                    <TextBlock x:Name="VersionText" Text="1.0.0" FontSize="11"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="简洁、轻量的 Minecraft 启动器" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                            <TextBlock Text="支持原版与 Fabric 安装、资源下载、版本隔离、Java 自动匹配与离线账户。界面与交互参考 PCL2 的设计。"
                                       Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="560"/>

                            <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center">
                                    <Run Text="作者："/><Run Text="楼小乐" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </TextBlock>
                                <Border Width="1" Height="11" Margin="10,0" VerticalAlignment="Center"
                                        Background="{DynamicResource BorderBrush}"/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center">
                                    <Run Text="问题反馈 Q 群："/><Run Text="416980382" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </TextBlock>
                                <Button Style="{StaticResource GhostButton}" Content="复制群号"
                                        Margin="8,0,0,0" Padding="4,2" FontSize="11" Click="CopyGroup_Click"
                                        ToolTip="复制群号 416980382"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Content="打开数据目录" Padding="16,9"
                                    Click="OpenData_Click"/>
                            <Button x:Name="CheckUpdateButton" Style="{StaticResource SecondaryButton}" Content="检查更新"
                                    Padding="14,7" Margin="0,6,0,0" Click="CheckUpdate_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="打开游戏目录" FontSize="11" Margin="0,6,0,0"
                                    Click="OpenGameDir_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 功能特性 -->
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="功能特性" Style="{StaticResource SectionTitleText}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentLightBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="VR" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                </Border>
                                <TextBlock Text="版本管理" FontSize="13" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <TextBlock Text="版本继承解析、内存与 Java 独立配置、版本隔离" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,16">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SuccessLightBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="DL" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                                <TextBlock Text="资源下载" FontSize="13" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <TextBlock Text="原版游戏、Fabric、Modrinth 模组、资源包与光影" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource WarningLightBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="JV" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                </Border>
                                <TextBlock Text="Java 环境" FontSize="13" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <TextBlock Text="自动检测本机 Java，缺失时可下载 Mojang 运行时" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentLightBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="AC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                </Border>
                                <TextBlock Text="账户系统" FontSize="13" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <TextBlock Text="离线账户创建与切换，后续扩展微软与第三方登录" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,16,0">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SuccessLightBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="LG" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                                <TextBlock Text="日志诊断" FontSize="13" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <TextBlock Text="启动器与游戏日志集中查看，便于排查启动问题" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource DangerLightBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="UI" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                </Border>
                                <TextBlock Text="现代化界面" FontSize="13" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <TextBlock Text="无边框窗口、主题色切换与轻量过渡动画" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 致谢 -->
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="致谢与说明" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,10,0,0" LineHeight="20">
                            LXLPCL 的界面布局、交互方式与功能设计参考了开源的
                            Plain Craft Launcher 2（PCL2）。感谢 PCL2 作者与社区的开源贡献。
                            游戏资源来自 Mojang、BMCLAPI、Fabric 与 Modrinth 提供的公开接口。
                            本启动器不隶属于 Mojang 或 Microsoft。
                        </TextBlock>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="GitHub 仓库" Padding="14,7"
                                    Click="OpenRepo_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="下载最新版本" Padding="14,7"
                                    Margin="8,0,0,0" Click="OpenReleases_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="PCL2 开源项目" Padding="14,7"
                                    Margin="8,0,0,0" Click="OpenPcl_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Modrinth" Padding="14,7"
                                    Margin="8,0,0,0" Click="OpenModrinth_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="BMCLAPI" Padding="14,7"
                                    Margin="8,0,0,0" Click="OpenBmcl_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Fabric" Padding="14,7"
                                    Margin="8,0,0,0" Click="OpenFabric_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 信息 -->
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="运行信息" Style="{StaticResource SectionTitleText}"/>
                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="运行环境" Style="{StaticResource HintText}"/>
                            <TextBlock Text=".NET 8 · WPF" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="配置文件" Style="{StaticResource HintText}"/>
                            <TextBlock Text="LXLPCL.json" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="数据目录" Style="{StaticResource HintText}"/>
                            <TextBlock x:Name="DataDirText" Text="LXLPCLData" FontSize="12" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="日志文件" Style="{StaticResource HintText}"/>
                            <TextBlock x:Name="LogFileText" Text="LXLPCLData\logs\latest.log" FontSize="12"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="游戏目录" Style="{StaticResource HintText}"/>
                            <TextBlock x:Name="GameDirText" Text=".minecraft" FontSize="12" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:PageBase>
