<local:PageBase x:Class="LXLPCL.UI.Pages.MultiplayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LXLPCL"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,14">
            <StackPanel>
                <TextBlock Text="联机" Style="{StaticResource PageTitleText}"/>
                <TextBlock x:Name="SubtitleText" Text="局域网联机与服务器直连"
                           Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Content="刷新本机地址" Margin="0,0,8,0"
                        Click="Refresh_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="启动游戏" Click="Launch_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,0,12">
            <TextBlock Text="联机方式" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <RadioButton x:Name="ModeLanRadio" Style="{StaticResource PclRadioButton}" Content="局域网"
                         GroupName="MultiplayerMode" Tag="lan" Checked="Mode_Checked"
                         ToolTip="同一局域网内直连，延迟最低"/>
            <RadioButton x:Name="ModeDirectRadio" Style="{StaticResource PclRadioButton}" Content="直连服务器"
                         GroupName="MultiplayerMode" Tag="direct" Margin="16,0,0,0" Checked="Mode_Checked"
                         ToolTip="连接公网服务器，可测试连通性"/>
            <RadioButton x:Name="ModeSakuraRadio" Style="{StaticResource PclRadioButton}" Content="樱花映射"
                         GroupName="MultiplayerMode" Tag="sakura" Margin="16,0,0,0" Checked="Mode_Checked"
                         ToolTip="通过 SakuraFrp 内网穿透，让外网朋友也能连进来"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.75*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel x:Name="LanPanel">
                    <!-- 局域网联机 -->
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="局域网联机" Style="{StaticResource CardTitleText}"/>
                            <TextBlock Text="一个人进入游戏后按 Esc → 「对局域网开放」，其他人用下面这个地址加入。"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="88"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="IpCombo" Style="{StaticResource PclComboBox}" Height="38"
                                          ToolTip="选择要分享给朋友的本机地址（多网卡时逐个试）"/>
                                <TextBlock Grid.Column="1" Text="端口" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" Margin="10,0,8,0"/>
                                <TextBox x:Name="PortBox" Grid.Column="2" Text="25565" Height="38"
                                         Style="{StaticResource PclTextBox}" Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="游戏内「对局域网开放」聊天栏里显示的端口号"/>
                            </Grid>

                            <TextBlock x:Name="LocalAddressText" Text="-" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,10,0,0" Foreground="{DynamicResource AccentTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="复制地址" Margin="0,0,8,0"
                                        Click="CopyLocal_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="打开本机网络设置"
                                        Click="OpenNetwork_Click" ToolTip="查看防火墙与网卡状态"/>
                            </WrapPanel>

                            <TextBlock x:Name="LocalHintText" Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Text="提示：房东需要在防火墙里允许 Java 通过，否则朋友会显示「连接超时」。"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <StackPanel x:Name="DirectPanel">
                    <!-- 直连服务器 -->
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="直连服务器" Style="{StaticResource CardTitleText}"/>
                            <TextBlock Text="输入服务器地址，可在游戏「多人游戏 → 添加服务器」里粘贴使用。"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ServerBox" Style="{StaticResource PclTextBox}" Height="38"
                                         Padding="10,0" VerticalContentAlignment="Center"
                                         ToolTip="例如 mc.hypixel.net 或 127.0.0.1:25565"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="测试连接"
                                        Margin="8,0,0,0" x:Name="TestButton" Click="Test_Click"/>
                            </Grid>

                            <TextBlock x:Name="ServerStatusText" Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text=""/>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="复制地址" Margin="0,0,8,0"
                                        Click="CopyServer_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="保存到最近使用"
                                        Click="SaveServer_Click"/>
                            </WrapPanel>

                            <TextBlock Text="最近使用" Style="{StaticResource HintText}" Margin="0,14,0,0"/>
                            <WrapPanel x:Name="HistoryPanel" Margin="0,7,0,0"/>
                            <TextBlock x:Name="HistoryEmptyText" Text="还没有保存过服务器地址"
                                       Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <StackPanel x:Name="SakuraPanel">
                        <!-- 樱花内网穿透 -->
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="樱花映射（SakuraFrp）" Style="{StaticResource CardTitleText}"/>
                                <TextBlock Text="先在 natfrp.com（原 sakurafrp.com）注册并创建「Minecraft Java」隧道，本地端口填游戏端口，再把隧道 ID 填到这里一键启动。"
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="96"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SakuraTunnelBox" Style="{StaticResource PclTextBox}" Height="38"
                                             Padding="10,0" VerticalContentAlignment="Center"
                                             ToolTip="在樱花控制台隧道详情页可以看到，一般是一串数字"/>
                                    <TextBlock Grid.Column="1" Text="本地端口" Style="{StaticResource HintText}"
                                               VerticalAlignment="Center" Margin="10,0,8,0"/>
                                    <TextBox x:Name="SakuraPortBox" Grid.Column="2" Text="25565" Height="38"
                                             Style="{StaticResource PclTextBox}" Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             ToolTip="与游戏「对局域网开放」时的端口保持一致"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SakuraPathBox" Style="{StaticResource PclTextBox}" Height="34"
                                             Padding="10,0" VerticalContentAlignment="Center" IsReadOnly="True"
                                             FontSize="11"
                                             ToolTip="SakuraLauncher.exe 的位置，留空时会自动查找"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Content="自动查找"
                                                Margin="0,0,6,0" Click="SakuraFind_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="选择…"
                                                Click="SakuraBrowse_Click"/>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="SakuraStartButton" Style="{StaticResource PrimaryButton}"
                                            Content="启动隧道" Margin="0,0,8,0" Click="SakuraStart_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="下载樱花软件"
                                            Margin="0,0,8,0" Click="SakuraDownload_Click"
                                            ToolTip="打开官网下载页，安装后即可一键启动隧道"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="打开樱花官网"
                                            Margin="0,0,8,0" Click="SakuraSite_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="樱花控制台"
                                            Margin="0,0,8,0" Click="SakuraConsole_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="复制访问地址"
                                            Click="SakuraCopy_Click"/>
                                </WrapPanel>

                                <TextBlock x:Name="SakuraStatusText" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="尚未启动：请先填写隧道 ID"/>

                                <TextBlock Text="樱花控制台里的访问地址（如 hk.example.com:25565）"
                                           Style="{StaticResource HintText}" Margin="0,12,0,0"/>
                                <TextBox x:Name="SakuraRemoteBox" Style="{StaticResource PclTextBox}" Height="38"
                                         Padding="10,0" VerticalContentAlignment="Center" Margin="0,6,0,0"
                                         TextChanged="SakuraRemote_Changed"
                                         ToolTip="隧道建立后樱花会给出形如 hk-1.example.com:12345 的地址"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="使用说明" Style="{StaticResource CardTitleText}"/>
                                <TextBlock Text="1. 樱花账号需实名认证，并创建一个 TCP / Minecraft Java 隧道（未安装请点上方「下载樱花软件」）"
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock Text="2. 本地端口与「对局域网开放」的端口一致（默认 25565）"
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="3. 点「启动隧道」，樱花启动器会开一个控制台窗口显示连接状态"
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="4. 把访问地址发给朋友，对方直接添加服务器即可"
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="联机步骤" Style="{StaticResource CardTitleText}"/>
                            <TextBlock Text="1. 双方使用相同的游戏版本与模组" Style="{StaticResource HintText}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock Text="2. 房东进入存档，按 Esc → 对局域网开放" Style="{StaticResource HintText}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="Step3Text" Text="3. 把本页复制的地址发给朋友" Style="{StaticResource HintText}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="4. 朋友在多人游戏里添加并加入" Style="{StaticResource HintText}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="当前状态" Style="{StaticResource CardTitleText}"/>
                            <TextBlock x:Name="AccountText" Style="{StaticResource HintText}" Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="离线账户也能联机：双方账户名不能重复，且主机不要用正版验证服务器。"
                                       Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:PageBase>
