<local:PageBase x:Class="LXLPCL.UI.Pages.MySkinsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LXLPCL"
             xmlns:controls="clr-namespace:LXLPCL.UI.Controls"
             FontFamily="{StaticResource AppFont}">
    <local:PageBase.Resources>
        <LinearGradientBrush x:Key="ModelStageBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF2F353F" Offset="0"/>
            <GradientStop Color="#FF14171C" Offset="1"/>
        </LinearGradientBrush>
    </local:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,14">
            <StackPanel>
                <TextBlock Text="我的皮肤" Style="{StaticResource PageTitleText}"/>
                <TextBlock x:Name="CountText" Text="共 0 张皮肤" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Content="刷新" Margin="0,0,8,0"
                        Click="Refresh_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="打开皮肤文件夹" Margin="0,0,8,0"
                        Click="OpenFolder_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="制作新皮肤" Click="NewSkin_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
            <StackPanel>
                <ItemsControl x:Name="SkinCards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,12,12" Width="200">
                                <StackPanel>
                                    <Border Height="168" CornerRadius="8" ClipToBounds="True"
                                            Background="{StaticResource ModelStageBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Preview_Click"
                                            ToolTip="点击放大查看，可切换视角并拖动旋转">
                                        <controls:SkinModelView Skin="{Binding Image}" Yaw="-24" Zoom="1.05"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="0,9,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding DetailText}" FontSize="10.5" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FullText}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding UseText}"
                                            IsEnabled="{Binding UseEnabled}" FontSize="11.5" Padding="0,4"
                                            Margin="0,9,0,0" Tag="{Binding}" Click="Use_Click"/>
                                    <WrapPanel Margin="0,7,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="重命名" FontSize="10.5"
                                                Padding="5,2" Margin="0,0,5,0" Tag="{Binding}" Click="Rename_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="编辑" FontSize="10.5"
                                                Padding="5,2" Margin="0,0,5,0" Tag="{Binding}" Click="Edit_Click"
                                                ToolTip="在皮肤制作中打开这张皮肤"/>
                                        <Button Style="{StaticResource GhostButton}" Content="导出" FontSize="10.5"
                                                Padding="5,2" Margin="0,0,5,0" Tag="{Binding}" Click="Export_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="删除" FontSize="10.5"
                                                Padding="5,2" Tag="{Binding}" Click="Delete_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="28" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="还没有保存的皮肤" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="在「皮肤制作」里画好后点击右上角「保存到皮肤库」，这里就会出现。" FontSize="11.5"
                                   Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="去制作皮肤" Margin="0,14,0,0"
                                HorizontalAlignment="Center" Click="NewSkin_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:PageBase>
