<local:PageBase x:Class="LXLPCL.UI.Pages.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LXLPCL"
             xmlns:controls="clr-namespace:LXLPCL.UI.Controls"
             FontFamily="{StaticResource AppFont}">
    <local:PageBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="DownloadNav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="11,9" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DownloadNavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ResourceMetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <Style x:Key="ModCardItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceGlassBrush}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,9">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLighterBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource PclComboBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ModCategoryChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLighterBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,5,4"/>
        </Style>
    </local:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,14">
            <StackPanel>
                <TextBlock Text="下载" Style="{StaticResource PageTitleText}"/>
                <TextBlock x:Name="DownloadSubtitle" Text="安装原版游戏、Fabric 加载器与社区资源"
                           Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource Badge}" Background="{DynamicResource SuccessLightBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SourceBadgeText" Text="下载源：自动" FontSize="11"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧分类 -->
            <Border Style="{StaticResource Card}" Padding="10,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="下载内容" Style="{StaticResource CardTitleText}" Margin="8,0,0,8"/>
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavVanilla" Style="{StaticResource DownloadNav}" GroupName="DownloadNav"
                                     Tag="vanilla" IsChecked="True" Checked="DownloadNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="游戏本体" Style="{StaticResource DownloadNavText}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavFabric" Style="{StaticResource DownloadNav}" GroupName="DownloadNav"
                                     Tag="fabric" Checked="DownloadNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Fabric 加载器" Style="{StaticResource DownloadNavText}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMod" Style="{StaticResource DownloadNav}" GroupName="DownloadNav"
                                     Tag="mod" Checked="DownloadNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="模组" Style="{StaticResource DownloadNavText}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavResourcePack" Style="{StaticResource DownloadNav}" GroupName="DownloadNav"
                                     Tag="resourcepack" Checked="DownloadNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="资源包" Style="{StaticResource DownloadNavText}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavShader" Style="{StaticResource DownloadNav}" GroupName="DownloadNav"
                                     Tag="shader" Checked="DownloadNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="光影" Style="{StaticResource DownloadNavText}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="资源来源" Style="{StaticResource HintText}"/>
                            <TextBlock Text="Modrinth 社区" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SourceHintText" Text="BMCLAPI 镜像加速" Style="{StaticResource HintText}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 原版版本列表 -->
            <Border x:Name="VersionPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="安装游戏本体" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="选择任意正式版或快照，安装完成后即可启动"
                                       Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="RefreshVersions_Click" ToolTip="刷新版本列表"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource FilterChip}" GroupName="VersionFilter" Tag="all"
                                         Content="全部" IsChecked="True" Checked="VersionFilter_Checked" Margin="0,0,7,0"/>
                            <RadioButton Style="{StaticResource FilterChip}" GroupName="VersionFilter" Tag="release"
                                         Content="正式版" Checked="VersionFilter_Checked" Margin="0,0,7,0"/>
                            <RadioButton Style="{StaticResource FilterChip}" GroupName="VersionFilter" Tag="snapshot"
                                         Content="快照" Checked="VersionFilter_Checked" Margin="0,0,7,0"/>
                            <RadioButton Style="{StaticResource FilterChip}" GroupName="VersionFilter" Tag="ancient"
                                         Content="远古版本" Checked="VersionFilter_Checked"/>
                        </StackPanel>
                        <Grid Width="200" HorizontalAlignment="Right">
                            <TextBox x:Name="VersionSearchBox" Style="{StaticResource PclTextBox}" Height="30"
                                     FontSize="12" TextChanged="VersionSearchBox_TextChanged"/>
                            <TextBlock Text="搜索版本号..." IsHitTestVisible="False" Margin="11,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=VersionSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="VersionStatusText" Grid.Row="2" Text="正在获取版本列表..."
                               Style="{StaticResource HintText}" Margin="0,10,0,6"/>

                    <ListBox x:Name="VersionList" Grid.Row="3" Style="{StaticResource PclListBox}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold"/>
                                            <Border Style="{StaticResource Badge}" Background="{DynamicResource SuccessLightBrush}"
                                                    Margin="7,0,0,0" Padding="5,0"
                                                    Visibility="{Binding IsLatestRelease, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="最新" FontSize="9" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0">
                                            <Run Text="{Binding TypeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DateText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SoftButton}" Content="{Binding InstallText}"
                                            Padding="15,5" FontSize="12" Tag="{Binding Id}" Click="InstallVersion_Click"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Fabric -->
            <Border x:Name="FabricPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="24" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="11" Background="{DynamicResource AccentGradientBrush}">
                                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="安装 Fabric 加载器" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Text="轻量、更新快的模组加载器，适合大多数整合包与模组"
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource FlatCard}" Padding="18" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="选择游戏版本" Style="{StaticResource CardTitleText}"/>
                                <ComboBox x:Name="FabricMcCombo" Style="{StaticResource PclComboBox}" Height="40"
                                          Margin="0,7,0,0" DisplayMemberPath="Id" SelectionChanged="FabricMc_SelectionChanged"/>

                                <TextBlock Text="Fabric Loader 版本" Style="{StaticResource CardTitleText}" Margin="0,16,0,0"/>
                                <ComboBox x:Name="FabricLoaderCombo" Style="{StaticResource PclComboBox}" Height="40"
                                          Margin="0,7,0,0" DisplayMemberPath="Display"/>

                                <TextBlock x:Name="FabricStatusText"
                                           Text="如果所选原版尚未安装，启动器会先自动安装原版游戏。"
                                           Style="{StaticResource HintText}" Margin="0,14,0,0" TextWrapping="Wrap"/>

                                <Button x:Name="FabricInstallButton" Style="{StaticResource PrimaryButton}"
                                        Content="安装 Fabric" HorizontalAlignment="Left" MinWidth="150" Margin="0,16,0,0"
                                        Click="InstallFabric_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource AccentLighterBrush}" CornerRadius="8" Padding="14,11" Margin="0,16,0,0">
                            <TextBlock Text="提示：Fabric 只负责加载模组，模组本身仍需与游戏版本匹配。安装完成后可在“下载 → 模组”中挑选适配模组。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Modrinth 资源 -->
            <Border x:Name="ModrinthPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="20" Visibility="Collapsed">
                <Grid>
                    <!-- 列表视图 -->
                    <Grid x:Name="ResourceListView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="ResourceTitle" Text="模组" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock x:Name="ResourceCaption" Text="来自 Modrinth 社区，下载后自动放入当前版本目录"
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="RefreshModrinth_Click" ToolTip="重新搜索"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="ModSearchBox" Style="{StaticResource PclTextBox}" Height="36"
                                         KeyDown="ModSearchBox_KeyDown"/>
                                <TextBlock x:Name="ModSearchHint" Text="搜索模组名称..." IsHitTestVisible="False" Margin="11,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ModSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="ModSearchButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="搜索" MinWidth="76"
                                    Margin="8,0,0,0" Click="SearchModrinth_Click"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <ComboBox x:Name="ModVersionFilter" Style="{StaticResource ModFilterCombo}" Width="132"
                                      DisplayMemberPath="Display" SelectionChanged="ModFilter_SelectionChanged"
                                      ToolTip="按游戏版本筛选"/>
                            <ComboBox x:Name="ModLoaderFilter" Style="{StaticResource ModFilterCombo}" Width="106"
                                      Margin="7,0,0,0" DisplayMemberPath="Display"
                                      SelectionChanged="ModFilter_SelectionChanged" ToolTip="按模组加载器筛选"/>
                            <ComboBox x:Name="ModCategoryFilter" Style="{StaticResource ModFilterCombo}" Width="120"
                                      Margin="7,0,0,0" DisplayMemberPath="Display"
                                      SelectionChanged="ModFilter_SelectionChanged" ToolTip="按分类筛选"/>
                            <ComboBox x:Name="ModSortFilter" Style="{StaticResource ModFilterCombo}" Width="106"
                                      Margin="7,0,0,0" DisplayMemberPath="Display"
                                      SelectionChanged="ModFilter_SelectionChanged" ToolTip="排序方式"/>
                            <Button Style="{StaticResource GhostButton}" Content="重置" FontSize="11" Padding="9,5"
                                    Margin="6,0,0,0" Click="ResetModFilters_Click" ToolTip="清除全部筛选条件"/>
                        </StackPanel>

                        <TextBlock x:Name="ResourceStatusText" Grid.Row="3" Text="" Style="{StaticResource HintText}"
                                   Margin="1,9,0,3" TextTrimming="CharacterEllipsis"/>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="ModList" Grid.Row="0" Style="{StaticResource PclListBox}" Margin="0,3,0,0"
                                     ItemContainerStyle="{StaticResource ModCardItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid PreviewMouseLeftButtonUp="ModCard_Click" Tag="{Binding}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" CornerRadius="10"
                                                    Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Top">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,52,52" RadiusX="10" RadiusY="10"/>
                                                </Border.Clip>
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentTextBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <controls:AsyncImage Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding MetaText}" Style="{StaticResource ResourceMetaText}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource SoftButton}" Content="安装"
                                                    Padding="15,5" FontSize="12" Tag="{Binding}" Click="InstallMod_Click"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="ModEmptyPanel" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="没有找到匹配的项目" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="试试更换筛选条件或搜索关键词" Style="{StaticResource HintText}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button x:Name="ModLoadMoreButton" Grid.Row="1" Style="{StaticResource SecondaryButton}"
                                    Content="加载更多" HorizontalAlignment="Center" MinWidth="140" Padding="16,7"
                                    Margin="0,8,0,0" Visibility="Collapsed" Click="LoadMoreMods_Click"/>
                        </Grid>
                    </Grid>

                    <!-- 详情视图 -->
                    <Grid x:Name="ModDetailView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0,4"
                                Click="BackToList_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="返回列表" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="14" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" CornerRadius="12" Background="{DynamicResource AccentLightBrush}"
                                        VerticalAlignment="Top">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,64,64" RadiusX="12" RadiusY="12"/>
                                    </Border.Clip>
                                    <Grid>
                                        <TextBlock x:Name="DetailInitialText" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <controls:AsyncImage x:Name="DetailIcon" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailTitleText" FontSize="17" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailAuthorText" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="DetailMetaText" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
                                    <ItemsControl x:Name="DetailCategoryList" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ModCategoryChip}">
                                                    <TextBlock Text="{Binding}" FontSize="10"
                                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Content="安装适配版本" Padding="14,7"
                                            FontSize="12" Click="InstallDetail_Click"/>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="转到 Modrinth"
                                            FontSize="11.5" Padding="12,5" Margin="0,0,8,0" Click="OpenModrinth_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="转到 MC 百科"
                                            FontSize="11.5" Padding="12,5" Margin="0,0,8,0" Click="OpenMcmod_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="复制名称"
                                            FontSize="11.5" Padding="12,5" Click="CopyName_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Margin="0,8,0,0" Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="12,8,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="项目介绍" FontSize="11.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BodyLangHint" FontSize="10" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <Button x:Name="BodyLangButton" Style="{StaticResource GhostButton}"
                                            Content="查看原文" FontSize="10" Padding="6,2"
                                            HorizontalAlignment="Right" Visibility="Collapsed"
                                            Click="BodyLang_Click"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" MaxHeight="176" VerticalScrollBarVisibility="Auto"
                                              Padding="12,6,12,9">
                                    <TextBlock x:Name="DetailBodyText" TextWrapping="Wrap" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="版本列表" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DetailVersionStatusText" Style="{StaticResource HintText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ListBox x:Name="ModVersionList" Grid.Row="1" Style="{StaticResource PclListBox}"
                                     ItemContainerStyle="{StaticResource PclListBoxItem}" Margin="0,5,0,0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="7,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding VersionNumber}" FontSize="12.5"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentLighterBrush}"
                                                            Margin="7,0,0,0" Padding="6,1">
                                                        <TextBlock Text="{Binding VersionTypeText}" FontSize="9"
                                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding GameVersionsText}" Style="{StaticResource HintText}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding LoadersText}" Style="{StaticResource ResourceMetaText}"/>
                                                    <TextBlock Text="  ·  " Style="{StaticResource ResourceMetaText}"/>
                                                    <TextBlock Text="{Binding PublishedText}" Style="{StaticResource ResourceMetaText}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="{Binding InstallText}"
                                                    Padding="13,4" FontSize="11" Tag="{Binding}"
                                                    Click="InstallModVersion_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 下载状态条 -->
        <Border x:Name="DownloadStatusBar" Grid.Row="2" Background="{DynamicResource SurfaceGlassBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,9" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DownloadTitleText" Text="正在下载" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DownloadPercentText" Text="0%" Style="{StaticResource HintText}"/>
                </StackPanel>
                <ProgressBar x:Name="DownloadProgress" Grid.Column="1" Height="5" Margin="16,0" VerticalAlignment="Center"
                             Background="{DynamicResource HoverBrush}" Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0"/>
                <TextBlock x:Name="DownloadDetailText" Grid.Column="2" Text="" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="DownloadCancelButton" Grid.Column="3" Style="{StaticResource GhostButton}" Content="取消"
                        Click="DownloadCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</local:PageBase>
