<local:PageBase x:Class="LXLPCL.UI.Pages.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LXLPCL"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,14">
            <StackPanel>
                <TextBlock Text="启动游戏" Style="{StaticResource PageTitleText}"/>
                <TextBlock x:Name="GreetingText" Text="欢迎回来" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="VersionCountText" Text="0 个版本" Style="{StaticResource HintText}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Refresh_Click" ToolTip="刷新版本列表"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.08*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：启动卡片 -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,10,0">
                                    <ComboBox x:Name="VersionCombo" Style="{StaticResource PclComboBox}" Height="48"
                                              SelectionChanged="VersionCombo_SelectionChanged"
                                              ToolTip="选择要启动的游戏版本">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="30" Height="30">
                                                        <Border CornerRadius="8" Background="{Binding IconBrush}">
                                                            <TextBlock Text="{Binding IconText}" Foreground="White" FontSize="11"
                                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding Logo}" Stretch="UniformToFill">
                                                            <Image.Clip>
                                                                <RectangleGeometry Rect="0,0,30,30" RadiusX="8" RadiusY="8"/>
                                                            </Image.Clip>
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock x:Name="VersionEmptyLabel" Text="暂无版本，请先在下载页安装"
                                               Margin="13,0,40,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"
                                               IsHitTestVisible="False" Visibility="Collapsed"/>
                                </Grid>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8B7;"
                                        Width="46" Height="46" Click="OpenVersionFolder_Click" ToolTip="打开版本文件夹"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="2,20,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="64" Height="64" Effect="{StaticResource CardShadow}">
                                        <Border x:Name="VersionIconTile" CornerRadius="14"
                                                Background="{DynamicResource AccentGradientBrush}">
                                            <TextBlock x:Name="VersionIconText" Text="MC" Foreground="White" FontSize="20"
                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image x:Name="VersionLogoImage" Stretch="UniformToFill" Visibility="Collapsed">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="VersionNameText" Text="尚未安装版本" FontSize="24" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="VersionSubtitleText" Text="前往下载页安装一个 Minecraft 版本"
                                                   Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border x:Name="VersionBadge" Style="{StaticResource Badge}" Background="{DynamicResource SuccessLightBrush}">
                                        <TextBlock x:Name="VersionBadgeText" Text="纯净版本" FontSize="11"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </Border>
                                    <TextBlock x:Name="LastPlayedText" Text="尚未游玩" Style="{StaticResource HintText}"
                                               Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="LaunchButton" Grid.Row="2" Style="{StaticResource BigLaunchButton}" Height="106"
                                    Margin="0,20,0,0" Click="LaunchButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="46" Height="46" CornerRadius="23" Background="#30FFFFFF">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="启动游戏" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LaunchHintText" Text="点击开始冒险" Foreground="#D9FFFFFF"
                                                   FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="LaunchStatusText" Text="准备就绪" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ProgressBar x:Name="LaunchProgress" Height="4" Margin="0,8,12,0" Visibility="Collapsed"
                                                 Background="{DynamicResource HoverBrush}" Foreground="{DynamicResource AccentBrush}"
                                                 BorderThickness="0"/>
                                </StackPanel>
                                <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="取消"
                                        Visibility="Collapsed" Click="CancelButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 快捷入口 -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource OutlineButton}" Background="{DynamicResource SurfaceGlassBrush}"
                                Padding="12,10" Click="OpenGameFolder_Click" ToolTip="打开 .minecraft 文件夹">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentLightBrush}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="游戏目录" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="打开文件夹" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Background="{DynamicResource SurfaceGlassBrush}"
                                Padding="12,10" Click="VersionsButton_Click" ToolTip="管理已安装的版本">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentLightBrush}">
                                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="版本管理" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="模组与设置" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ModsQuickButton" Grid.Column="4" Style="{StaticResource OutlineButton}" Background="{DynamicResource SurfaceGlassBrush}"
                                Padding="12,10" Click="ModsButton_Click" ToolTip="管理当前版本的模组">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentLightBrush}">
                                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="模组管理" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="启用与删除" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="6" Style="{StaticResource OutlineButton}" Background="{DynamicResource SurfaceGlassBrush}"
                                Padding="12,10" Click="LogsButton_Click" ToolTip="查看启动日志">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentLightBrush}">
                                    <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="游戏日志" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="排错必备" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="8" Style="{StaticResource OutlineButton}" Background="{DynamicResource SurfaceGlassBrush}"
                                Padding="12,10" Click="SettingsButton_Click" ToolTip="打开启动器设置">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentLightBrush}">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="游戏设置" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="内存与 Java" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 右侧栏 -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="当前账户" Style="{StaticResource CardTitleText}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentLightBrush}">
                                    <TextBlock x:Name="AccountInitialText" Text="?" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountNameText" Text="未登录" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AccountTypeText" Text="点击右侧按钮登录" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="SwitchAccountButton" Style="{StaticResource SoftButton}"
                                        Content="添加账户" Padding="11,6" Click="SwitchAccount_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="游戏设置" Style="{StaticResource CardTitleText}"/>
                                <Button Style="{StaticResource LinkButton}" Content="全部设置" FontSize="11"
                                        HorizontalAlignment="Right" Click="SettingsButton_Click"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="内存" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton x:Name="AutoMemoryRadio" Style="{StaticResource PclRadioButton}"
                                                 Content="自动" GroupName="MainMemoryMode" Checked="MemoryMode_Checked"
                                                 ToolTip="按系统内存自动推荐分配"/>
                                    <RadioButton x:Name="CustomMemoryRadio" Style="{StaticResource PclRadioButton}"
                                                 Content="自定义" GroupName="MainMemoryMode" Margin="14,0,0,0"
                                                 Checked="MemoryMode_Checked"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="MemoryValueText" Text="4096 MB" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,6,0,0" Foreground="{DynamicResource AccentTextBrush}"/>
                            <Slider x:Name="MemorySlider" Style="{StaticResource PclSlider}" Minimum="512" Maximum="16384"
                                    TickFrequency="512" IsSnapToTickEnabled="False" Margin="0,6,0,0" ValueChanged="MemorySlider_ValueChanged"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="Java" FontSize="12" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource LinkButton}" Content="刷新" FontSize="11"
                                        HorizontalAlignment="Right" Click="RefreshJava_Click"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="JavaCombo" Style="{StaticResource PclComboBox}" Height="36"
                                          DisplayMemberPath="Display" SelectionChanged="JavaCombo_SelectionChanged"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8B7;"
                                        Width="34" Height="34" Margin="6,0,0,0" Click="BrowseJava_Click" ToolTip="手动选择 Java"/>
                            </Grid>
                            <TextBlock x:Name="JavaHintText" Text="" Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="版本信息" Style="{StaticResource CardTitleText}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="路径" Style="{StaticResource HintText}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="VersionPathText" Grid.Column="1" Text="-" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,7"/>
                                <TextBlock Grid.Row="1" Text="加载器" Style="{StaticResource HintText}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="VersionLoaderText" Grid.Row="1" Grid.Column="1" Text="原版" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock Grid.Row="2" Text="类型" Style="{StaticResource HintText}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="VersionTypeText" Grid.Row="2" Grid.Column="1" Text="正式版" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock Grid.Row="3" Text="模组" Style="{StaticResource HintText}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="VersionModsText" Grid.Row="3" Grid.Column="1" Text="0 个已启用" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock Grid.Row="4" Text="Java" Style="{StaticResource HintText}"/>
                                <TextBlock x:Name="VersionJavaText" Grid.Row="4" Grid.Column="1" Text="Java 8" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                            <Button Style="{StaticResource SecondaryButton}" Content="打开版本文件夹" Margin="0,14,0,0"
                                    Click="OpenVersionFolder_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:PageBase>
