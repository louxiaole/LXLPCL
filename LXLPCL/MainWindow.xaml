<Window x:Class="LXLPCL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LXLPCL" Width="1150" Height="720" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}" Icon="Assets/lx.ico"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 主题背景（内置于 Assets/Themes，或用户自选图片） -->
        <Rectangle x:Name="ThemeBackgroundLayer" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Rectangle x:Name="ThemeBackgroundMask" Grid.RowSpan="3" Fill="{DynamicResource MaskBrush}"
                   Visibility="Collapsed" IsHitTestVisible="False"/>
        <!-- 顶部渐隐，保证页面标题在插画背景上依然清晰 -->
        <Rectangle x:Name="ThemeTopFade" Grid.RowSpan="3" Height="150" VerticalAlignment="Top"
                   Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceGlassBrush}" x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource AccentGradientBrush}">
                    <TextBlock Text="LX" Foreground="White" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="LXLPCL" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentLightBrush}" Margin="8,0,0,0" Padding="6,1">
                    <TextBlock Text="1.0.0" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/>
                </Border>
                <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="14,0,0,0"/>
                <TextBlock x:Name="TitleVersionText" Text="我的世界启动器" Margin="14,0,0,0" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Button x:Name="TitleAccountButton" Style="{StaticResource GhostButton}" Padding="8,4" Click="AccountButton_Click" ToolTip="账户管理">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="20">
                            <Ellipse Fill="{DynamicResource AccentLightBrush}"/>
                            <TextBlock x:Name="TitleAccountInitial" Text="?" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="TitleAccountName" Text="未登录" Margin="6,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="8,0"/>
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="最小化"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="最大化"/>
                <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="关闭"/>
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Background="{DynamicResource SurfaceGlassBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <RadioButton x:Name="NavLaunch" Style="{StaticResource SidebarNavButton}" Content="&#xE80F;"
                                     Tag="launch" ToolTip="启动游戏" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDownload" Style="{StaticResource SidebarNavButton}" Content="&#xE896;"
                                     Tag="download" ToolTip="下载" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavVersions" Style="{StaticResource SidebarNavButton}" Content="&#xE8F1;"
                                     Tag="versions" ToolTip="版本管理" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSkin" Style="{StaticResource SidebarNavButton}" Content="&#xE790;"
                                     Tag="skin" ToolTip="皮肤制作" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMySkins" Style="{StaticResource SidebarNavButton}" Content="&#xE8B9;"
                                     Tag="myskins" ToolTip="我的皮肤" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMultiplayer" Style="{StaticResource SidebarNavButton}" Content="&#xE774;"
                                     Tag="multiplayer" ToolTip="联机" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTranslate" Style="{StaticResource SidebarNavButton}" Content="&#xE8D2;"
                                     Tag="translate" ToolTip="汉化" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTools" Style="{StaticResource SidebarNavButton}" Content="&#xE90F;"
                                     Tag="tools" ToolTip="工具箱" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarNavButton}" Content="&#xE713;"
                                     Tag="settings" ToolTip="设置" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource SidebarNavButton}" Content="&#xE946;"
                                     Tag="about" ToolTip="关于" Checked="Nav_Checked"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Button x:Name="SidebarAccountButton" Style="{StaticResource IconButton}" Width="40" Height="40"
                                Click="AccountButton_Click" ToolTip="账户管理">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{DynamicResource AccentLightBrush}"/>
                                <TextBlock x:Name="SidebarAccountInitial" Text="?" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 页面容器 -->
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="20,16,20,12" Focusable="False"/>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceGlassBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="LXLPCL" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="StatusVersion" Text="未选择版本" FontSize="11" Margin="14,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="StatusRight" Grid.Column="2" Text="就绪" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
